#!/usr/bin/env bash
# Sync the WarpX uv environment. Extra arguments go through to `uv sync`.
. "$(dirname "${BASH_SOURCE[0]}")/warpx-env.sh"

root=$(warpx_root)
warpx_require_submodule "$root"
warpx_export_toolchain

export WARPX_MPI=OFF
export WARPX_COMPUTE=OMP
export WARPX_DIMS=3

uv sync --project "$root" "$@"
